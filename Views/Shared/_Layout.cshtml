<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Cafetería</title>
    <script src="https://cdn.tailwindcss.com/3.4.17"></script>
</head>
<body class="min-h-screen bg-white text-neutral-900 antialiased">
    <header class="border-b border-neutral-200">
        <div class="mx-auto flex max-w-2xl items-center justify-between px-5 py-4">
            <a asp-controller="Pedidos" asp-action="Index" class="font-semibold">Cafetería</a>
            <nav class="flex gap-5 text-sm text-neutral-600">
                <a asp-controller="Pedidos" asp-action="Index" class="hover:text-black">Pedidos</a>
                <a asp-controller="Pedidos" asp-action="Registrar" class="hover:text-black">Nuevo</a>
            </nav>
        </div>
    </header>

    <main class="mx-auto max-w-2xl px-5 py-8">
        @if (TempData["Mensaje"] is string mensaje)
        {
            <p class="mb-6 border-l-2 @(TempData["Error"] is true ? "border-black font-medium" : "border-neutral-300") bg-neutral-50 px-4 py-2 text-sm">@mensaje</p>
        }
        @RenderBody()
    </main>
</body>
</html>
