<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Barra Central</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,800&family=JetBrains+Mono:wght@400;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com/3.4.17"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        display: ['Fraunces', 'serif'],
                        mono: ['"JetBrains Mono"', 'monospace'],
                        sans: ['Inter', 'system-ui', 'sans-serif']
                    },
                    colors: {
                        espresso: '#1c1410',
                        roast: '#2a1d16',
                        crema: '#f3e9d8',
                        papel: '#fbf6ec',
                        caramelo: '#e0952f',
                        menta: '#4f9d82'
                    }
                }
            }
        }
    </script>
</head>
<body class="min-h-screen bg-espresso font-sans text-crema antialiased">
    <header class="border-b border-white/10">
        <div class="mx-auto flex max-w-5xl items-center justify-between px-5 py-4">
            <a asp-controller="Pedidos" asp-action="Index" class="flex items-center gap-3">
                <span class="grid h-10 w-10 place-items-center rounded-full bg-caramelo text-xl text-espresso">☕</span>
                <span class="font-display text-2xl font-extrabold tracking-tight">Barra Central</span>
            </a>
            <nav class="flex gap-2 text-sm font-medium">
                <a asp-controller="Pedidos" asp-action="Index" class="rounded-full px-4 py-2 text-crema/80 transition hover:bg-white/10 hover:text-crema">Comandas</a>
                <a asp-controller="Pedidos" asp-action="Registrar" class="rounded-full bg-caramelo px-4 py-2 text-espresso transition hover:brightness-110">+ Nuevo pedido</a>
            </nav>
        </div>
    </header>

    <main class="mx-auto max-w-5xl px-5 py-8">
        @if (TempData["Mensaje"] is string mensaje)
        {
            bool esError = TempData["Error"] is true;
            <div class="mb-6 flex items-center gap-3 rounded-xl border px-4 py-3 text-sm @(esError ? "border-red-400/40 bg-red-500/10 text-red-200" : "border-menta/40 bg-menta/10 text-emerald-100")">
                <span>@(esError ? "⚠️" : "✔")</span>
                <span>@mensaje</span>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="mx-auto max-w-5xl px-5 pb-8 font-mono text-xs text-crema/40">
        Cola FIFO · primero en llegar, primero en atenderse
    </footer>
</body>
</html>
