@{
    ViewData["Title"] = "Nuevo pedido";
}
<h1 class="text-xl font-semibold">Nuevo pedido</h1>
<p class="mt-1 text-sm text-neutral-500">El número se asigna automáticamente.</p>

<form method="post" asp-action="Registrar" class="mt-6 space-y-4">
    <div>
        <label for="cliente" class="mb-1 block text-sm">Cliente</label>
        <input type="text" id="cliente" name="cliente" value="@ViewBag.Cliente" maxlength="60" required autofocus
               class="w-full border border-neutral-300 px-3 py-2 focus:border-black focus:outline-none" />
    </div>
    <div>
        <label for="producto" class="mb-1 block text-sm">Producto</label>
        <input type="text" id="producto" name="producto" value="@ViewBag.Producto" maxlength="60" required
               class="w-full border border-neutral-300 px-3 py-2 focus:border-black focus:outline-none" />
    </div>
    <div class="flex gap-3">
        <button type="submit" class="bg-black px-4 py-2 text-sm text-white hover:bg-neutral-700">Registrar</button>
        <a asp-action="Index" class="border border-neutral-300 px-4 py-2 text-sm hover:bg-neutral-50">Cancelar</a>
    </div>
</form>
