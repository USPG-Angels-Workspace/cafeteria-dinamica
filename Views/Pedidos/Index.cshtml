@model List<Pedido>
@{
    ViewData["Title"] = "Pedidos";
    int pendientes = ViewBag.Pendientes;
    Pedido? siguiente = ViewBag.Siguiente;
}
<section class="flex items-end justify-between border-b border-neutral-200 pb-6">
    <div>
        <p class="text-sm text-neutral-500">Pendientes</p>
        <p class="text-5xl font-semibold">@pendientes</p>
    </div>
    <form method="post" asp-action="Atender">
        <button type="submit" disabled="@(pendientes == 0)"
                class="bg-black px-4 py-2 text-sm text-white hover:bg-neutral-700 disabled:cursor-not-allowed disabled:bg-neutral-300">
            Atender siguiente
        </button>
    </form>
</section>

<section class="border-b border-neutral-200 py-6">
    <p class="text-sm text-neutral-500">Siguiente pedido</p>
    @if (siguiente == null)
    {
        <p class="mt-1">No hay pedidos en espera.</p>
    }
    else
    {
        <p class="mt-1 text-lg font-medium">#@siguiente.Numero · @siguiente.Cliente</p>
        <p class="text-neutral-600">@siguiente.Producto</p>
    }
</section>

<section class="py-6">
    <h2 class="mb-3 text-sm text-neutral-500">Cola</h2>
    @if (Model.Count == 0)
    {
        <p class="text-neutral-600">La cola está vacía.</p>
    }
    else
    {
        <table class="w-full text-left text-sm">
            <thead class="border-b border-neutral-200 text-neutral-500">
                <tr><th class="py-2 font-normal">Orden</th><th class="font-normal">Pedido</th><th class="font-normal">Cliente</th><th class="font-normal">Producto</th></tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    var p = Model[i];
                    <tr class="border-b border-neutral-100 @(i == 0 ? "font-semibold" : "")">
                        <td class="py-2">@(i + 1)</td>
                        <td>#@p.Numero</td>
                        <td>@p.Cliente</td>
                        <td>@p.Producto</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
